// matematik paketi v1.0.0 - T-Sharp 4.2
// Gelismis matematik fonksiyonlari

fonksiyon mutlak sayi
  eger sayi < 0
    dondur sayi * -1
  son
  dondur sayi
son

fonksiyon kare sayi
  dondur sayi * sayi
son

fonksiyon kup sayi
  dondur sayi * sayi * sayi
son

fonksiyon us taban ustel
  degisken sonuc = 1
  degisken sayac = 0
  dongu sayac < ustel
    sonuc = sonuc * taban
    sayac = sayac + 1
  son
  dondur sonuc
son

fonksiyon faktoriyel sayi
  eger sayi <= 1
    dondur 1
  son
  dondur sayi * faktoriyel(sayi - 1)
son

fonksiyon asal_mi sayi
  eger sayi < 2
    dondur 0
  son
  degisken bolen = 2
  dongu bolen * bolen <= sayi
    eger sayi % bolen == 0
      dondur 0
    son
    bolen = bolen + 1
  son
  dondur 1
son

fonksiyon ebob a b
  dongu b != 0
    degisken kalan = a % b
    a = b
    b = kalan
  son
  dondur a
son

fonksiyon ekok a b
  dondur (a * b) / ebob(a, b)
son

fonksiyon daire_alani r
  dondur 3.14159 * r * r
son

fonksiyon daire_cevresi r
  dondur 2 * 3.14159 * r
son

fonksiyon ucgen_alani taban yukseklik
  dondur 0.5 * taban * yukseklik
son

fonksiyon dikdortgen_alani en boy
  dondur en * boy
son

fonksiyon kare_alani kenar
  dondur kenar * kenar
son
